# Model in "provider:model" form (any provider supported by LangChain init_chat_model)
PYCLEANER_MODEL=anthropic:claude-sonnet-5-5
# PYCLEANER_MODEL=openai:gpt-5
# PYCLEANER_MODEL=google_genai:gemini-2.5-pro
# PYCLEANER_MODEL=mistralai:mistral-large-latest
# PYCLEANER_MODEL=ollama:qwen3-coder

# API key of the chosen provider (each provider reads its own)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=

# Optional: compatible endpoint (OpenAI proxy, remote Ollama server…)
# PYCLEANER_BASE_URL=http://localhost:11434
# Optional: sampling temperature (unset = provider default; some models reject it)
# PYCLEANER_TEMPERATURE=0

# Interpreter used to verify the target project (compileall, manage.py check, pytest).
# Defaults to the one running py-cleaner.
# PYCLEANER_PYTHON=/path/to/project/.venv/bin/python
